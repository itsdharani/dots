# /bin/fish
editor nvim
term xterm-kitty

# -----------------------------------------
# Core Settings
# -----------------------------------------
allow_remote_control yes
listen_on unix:/tmp/kitty
kitty_mod ctrl+shift

# -----------------------------------------
# Font & Typography
# -----------------------------------------
font_family IBM Plex Mono
font_size 18.0
bold_font auto
italic_font auto
bold_italic_font auto
disable_ligatures never

# -----------------------------------------
# Keybindings
# -----------------------------------------
# Font size
map kitty_mod+equal change_font_size all +2.0
map kitty_mod+minus change_font_size all -2.0
map kitty_mod+0 change_font_size all 19.0

# Opacity
map kitty_mod+o set_background_opacity +0.05
map kitty_mod+i set_background_opacity -0.05
map kitty_mod+u set_background_opacity 0.75

# Windows
map kitty_mod+enter new_window_with_cwd
map kitty_mod+w close_window
map kitty_mod+h previous_window
map kitty_mod+l next_window
map kitty_mod+r start_resizing_window

# Tabs
map kitty_mod+t new_tab
map kitty_mod+q close_tab
map kitty_mod+left previous_tab
map kitty_mod+right next_tab
map kitty_mod+. move_tab_forward
map kitty_mod+, move_tab_backward

# Misc
map kitty_mod+g show_scrollback
map kitty_mod+f11 toggle_fullscreen
map kitty_mod+f toggle_layout stack
map kitty_mod+p load_config_file ~/.config/kitty/kitty.conf

# -----------------------------------------
# Bell & Notifications
# -----------------------------------------
enable_audio_bell no
visual_bell_duration 0.12
visual_bell_color #7eb8d4
bell_on_tab yes
window_alert_on_bell yes

# -----------------------------------------
# System Integration
# -----------------------------------------
linux_display_server auto
wayland_titlebar_color system
macos_titlebar_color system
sync_to_monitor yes

# -----------------------------------------
# Glass Effect
# -----------------------------------------
background_opacity 0.8
background_blur 30
dynamic_background_opacity yes

# -----------------------------------------
# Window Aesthetics
# -----------------------------------------
window_border_width 1.2
window_margin_width 2
window_padding_width 6 12 6 12
active_border_color   #2e527a
inactive_border_color #0f1a2e

# Cursor
cursor_shape block
cursor_blink_interval 0.5
cursor_stop_blinking_after 3.0
cursor #7eb8d4
cursor_text_color #080e1a

# -----------------------------------------
# Tab Bar - Minimal Elegance
# -----------------------------------------
tab_bar_margin_width 4.0
tab_bar_margin_height 6.0 4.0
tab_bar_style custom
tab_bar_background none
tab_bar_min_tabs 1

# Active tab
active_tab_background #2e527a
active_tab_foreground #96c09e
active_tab_font_style bold

# Inactive tabs
inactive_tab_background #0d1525
inactive_tab_foreground #3a5472
inactive_tab_font_style normal

# Tab separators
tab_separator "  ┇  "
tab_title_template "{title[:10]}"

# -----------------------------------------
# Color Palette - Abyssal Blue
# -----------------------------------------
background              #080e1a
foreground              #c8dff0

# Black & Gray
color0                  #080e1a
color8                  #1a2d4a

# Red - Muted coral
color1                  #e07a8f
color9                  #f09aaa

# Green - Muted sage
color2                  #7aa882
color10                 #96c09e

# Blue - Cornflower
color3                  #4d7ab5
color11                 #6a96d0

# Blue - Steel
color4                  #2e527a
color12                 #5b7fa6

# Magenta - Slate
color5                  #3d5fa0
color13                 #5a7ac0

# Cyan - Steel cyan
color6                  #6ba3be
color14                 #7eb8d4

# White - Cool mist
color7                  #7a9ab8
color15                 #c8dff0

# Selection
selection_background    #2e527a
selection_foreground    #c8dff0

# URL Styling
url_color               #7eb8d4
url_style               curly

# Mark Colors
mark1_background        #7eb8d4
mark1_foreground        #080e1a
mark2_background        #6ba3be
mark2_foreground        #080e1a
mark3_background        #b8d4e8
mark3_foreground        #080e1a

# -----------------------------------------
# Performance
# -----------------------------------------
mouse_hide_wait 2.0
focus_follows_mouse no

