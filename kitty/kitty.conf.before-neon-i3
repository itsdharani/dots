# /bin/fish
editor nvim
term xterm-kitty

# -----------------------------------------
# Core Settings
# -----------------------------------------
allow_remote_control yes
listen_on unix:/tmp/kitty
kitty_mod ctrl+shift

# -----------------------------------------
# Font & Typography
# -----------------------------------------
font_family IBM Plex Mono
font_size 20.0
bold_font auto
italic_font auto
bold_italic_font auto
disable_ligatures never

# -----------------------------------------
# Keybindings
# -----------------------------------------
# Font size
map kitty_mod+equal change_font_size all +2.0
map kitty_mod+minus change_font_size all -2.0
map kitty_mod+0 change_font_size all 20.0

# Opacity
map kitty_mod+o set_background_opacity +0.05
map kitty_mod+i set_background_opacity -0.05
map kitty_mod+u set_background_opacity 0.75

# Windows
map kitty_mod+enter new_window_with_cwd
map kitty_mod+w close_window
map kitty_mod+h previous_window
map kitty_mod+l next_window
map kitty_mod+r start_resizing_window

# Tabs
map kitty_mod+t new_tab
map kitty_mod+q close_tab
map kitty_mod+left previous_tab
map kitty_mod+right next_tab
map kitty_mod+. move_tab_forward
map kitty_mod+, move_tab_backward

# Misc
map kitty_mod+g show_scrollback
map kitty_mod+f11 toggle_fullscreen
map kitty_mod+f toggle_layout stack
map kitty_mod+p load_config_file ~/.config/kitty/kitty.conf

# -----------------------------------------
# Bell & Notifications
# -----------------------------------------
enable_audio_bell no
visual_bell_duration 0.12
visual_bell_color #6f8cff
bell_on_tab yes
window_alert_on_bell yes

# -----------------------------------------
# System Integration
# -----------------------------------------
linux_display_server auto
wayland_titlebar_color system
macos_titlebar_color system
sync_to_monitor yes

# -----------------------------------------
# Glass Effect
# -----------------------------------------
background_opacity 0.84
background_blur 26
dynamic_background_opacity yes

# -----------------------------------------
# Window Aesthetics
# -----------------------------------------
window_border_width 1.5
window_margin_width 1
window_padding_width 8 13 8 13
active_border_color   #6f8cff
inactive_border_color #23345f

# Cursor
cursor_shape block
cursor_blink_interval 0.5
cursor_stop_blinking_after 3.0
cursor #8fb4ff
cursor_text_color #070b18

# -----------------------------------------
# Tab Bar - Minimal Elegance
# -----------------------------------------
tab_bar_margin_width 4.0
tab_bar_margin_height 4.0 2.0
tab_bar_style custom
tab_bar_background none
tab_bar_min_tabs 1

# Active tab
active_tab_background #526fd6
active_tab_foreground #eef4ff
active_tab_font_style bold

# Inactive tabs
inactive_tab_background #101936
inactive_tab_foreground #7788bd
inactive_tab_font_style normal

# Tab separators
tab_separator "  ┇  "
tab_title_template "{title[:24]}"

# -----------------------------------------
# Color Palette - Ayanami Blue
# -----------------------------------------
background              #070b18
foreground              #dce7ff

# Black & Gray
color0                  #070b18
color8                  #23345f

# Red - Signal coral
color1                  #ff5f7e
color9                  #ff7f98

# Green - Soft neon
color2                  #66f0a8
color10                 #9fffc9

# Yellow - Pale amber
color3                  #f7d774
color11                 #ffe99a

# Blue - Console glow
color4                  #526fd6
color12                 #8fb4ff

# Magenta - Violet accent
color5                  #9a7cff
color13                 #c5b2ff

# Cyan - Ice trace
color6                  #59d8ff
color14                 #9beaff

# White - Cool mist
color7                  #9aa8d4
color15                 #f4f7ff

# Selection
selection_background    #526fd6
selection_foreground    #eef4ff

# URL Styling
url_color               #8fb4ff
url_style               curly

# Mark Colors
mark1_background        #8fb4ff
mark1_foreground        #070b18
mark2_background        #ff5f7e
mark2_foreground        #070b18
mark3_background        #59d8ff
mark3_foreground        #070b18

# -----------------------------------------
# Performance
# -----------------------------------------
mouse_hide_wait 2.0
focus_follows_mouse no
