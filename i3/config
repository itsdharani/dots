set $mod Mod4

exec --no-startup-id dex --autostart --environment i3
exec_always --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION
exec_always --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION
exec --no-startup-id systemctl --user start dunst.service
exec --no-startup-id systemctl --user start xdg-desktop-portal.service
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id feh --bg-fill /home/dharani/.dotfiles/wallpapers/nice-blue-background.png
exec --no-startup-id ~/.config/i3/setoutput
# REMOVED: exec --no-startup-id xclip (this does nothing useful)
exec_always --no-startup-id xset s off -dpms
exec_always --no-startup-id autotiling
exec_always --no-startup-id ~/.config/polybar/scripts/polybarstart.sh

set $terminal kitty
set $menu rofi -show drun

font pango:FiraCode Nerd Font 11


floating_modifier $mod
default_floating_border pixel 2

for_window [class="zoom"]         floating enable
for_window [class="Pavucontrol"]  floating enable
for_window [class="Blueman-manager"] floating enable


gaps inner 6
gaps outer 4
default_border pixel 2
smart_borders on
smart_gaps on


client.focused          #6f8cff  #101936  #eef4ff  #59d8ff   #6f8cff
client.focused_inactive #23345f  #0b1024  #9aa8d4  #23345f   #23345f
client.unfocused        #162242  #070b18  #68759f  #162242   #162242
client.urgent           #ff5f7e  #311223  #ffffff  #ff5f7e   #ff5f7e
client.placeholder      #070b18  #070b18  #9aa8d4  #070b18   #070b18


set $left  h
set $down  j
set $up    k
set $right l

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

bindsym $mod+g split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split


set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Tab workspace next

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10


bindsym $mod+Return       exec --no-startup-id $terminal
bindsym $mod+Shift+Return exec --no-startup-id $terminal -e ~/.local/bin/auto_tmux
bindsym $mod+a            exec --no-startup-id $menu
bindsym $mod+q            kill

bindsym $mod+p            exec --no-startup-id flameshot gui -c
bindsym $mod+Shift+p exec --no-startup-id sh -c 'grim -g "$(slurp)" - | wl-copy'
bindsym $mod+Shift+w      exec --no-startup-id i3lock -i ~/.config/hypr/wallpapers/lock.png
bindsym $mod+Shift+o      exec --no-startup-id ~/.local/bin/toggle_monitor
bindsym $mod+Shift+v      exec --no-startup-id ~/.config/i3/scripts/wallpaper.sh

bindsym $mod+Shift+n exec --no-startup-id redshift -P -O 4500
bindsym $mod+Shift+m exec --no-startup-id redshift -x && killall redshift

bindsym $mod+b exec --no-startup-id polybar-msg cmd toggle

bindsym $mod+Shift+c reload
bindsym $mod+m exec --no-startup-id i3-nagbar -t warning \
    -m 'Exit i3?' \
    -B 'Logout'    'i3-msg exit' \
    -B 'Suspend'   'systemctl suspend' \
    -B 'Hibernate' 'systemctl hibernate' \
    -B 'Reboot'    'systemctl reboot' \
    -B 'Shutdown'  'systemctl poweroff'


bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +2%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -2%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +1%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 1%-


mode "resize" {
    bindsym h resize shrink width  5 px or 5 ppt
    bindsym j resize grow   height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow   width  5 px or 5 ppt

    bindsym Left  resize shrink width  5 px or 5 ppt
    bindsym Down  resize grow   height 5 px or 5 ppt
    bindsym Up    resize shrink height 5 px or 5 ppt
    bindsym Right resize grow   width  5 px or 5 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"
