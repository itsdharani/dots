Qset $mod Mod4

#############################
# AUTOSTART
#############################

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id feh --bg-scale ~/wallpapers/galaxy.png
exec --no-startup-id ~/.config/i3/setoutput
exec --no-startup-id wl-paste --type text --watch cliphist store
exec --no-startup-id wl-paste --type image --watch cliphist store

exec_always --no-startup-id xset s off -dpms
exec_always --no-startup-id autotiling
exec_always --no-startup-id ~/.config/polybar/scripts/polybarstart.sh

#############################
# VARIABLES
#############################

set $terminal kitty
set $menu wofi --show drun

#############################
# FONT
#############################

font pango:JetBrainsMonoNL Nerd Font 0

#############################
# GENERAL / FLOATING
#############################

floating_modifier $mod
default_floating_border pixel 2

for_window [class="zoom"]         floating enable
for_window [class="Pavucontrol"]  floating enable
for_window [class="Blueman-manager"] floating enable

#############################
# GAPS / BORDERS
#############################

gaps inner 8
gaps outer 8
default_border pixel 2
smart_borders on
smart_gaps on

#############################
# COLORS (Catppuccin Mocha)
#############################

# class                 border   bg       text     indicator child_border
client.focused          #89b4fa  #89b4fa  #1e1e2e  #a6e3a1   #89b4fa
client.focused_inactive #45475a  #45475a  #cdd6f4  #45475a   #45475a
client.unfocused        #313244  #313244  #6c7086  #313244   #313244
client.urgent           #f38ba8  #f38ba8  #1e1e2e  #f38ba8   #f38ba8
client.placeholder      #1e1e2e  #1e1e2e  #cdd6f4  #1e1e2e   #1e1e2e

#############################
# NAVIGATION (vim keys)
#############################

set $left  h
set $down  j
set $up    k
set $right l

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

#############################
# LAYOUT
#############################

bindsym $mod+g split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

#############################
# WORKSPACES
#############################

set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Tab workspace next

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

#############################
# KEYBINDS
#############################

# Core
bindsym $mod+Return       exec --no-startup-id $terminal
bindsym $mod+Shift+Return exec --no-startup-id $terminal -e ~/.local/bin/auto_tmux
bindsym $mod+a            exec --no-startup-id $menu
bindsym $mod+q            kill

# Utilities
bindsym $mod+p            exec --no-startup-id flameshot gui
bindsym $mod+Shift+p      exec --no-startup-id bash -c 'next=1; while [ -f ~/Pictures/Screenshots/img-$next.png ]; do ((next++)); done; flameshot gui -p ~/Pictures/Screenshots/img-$next.png'
bindsym $mod+Shift+w      exec --no-startup-id i3lock -i ~/.config/hypr/wallpapers/lock.png
bindsym $mod+Shift+o      exec --no-startup-id ~/.local/bin/toggle_monitor
bindsym $mod+w            exec --no-startup-id ~/.config/i3/scripts/wallpaper.sh

# Night light
bindsym $mod+Shift+n exec --no-startup-id redshift -P -O 4500
bindsym $mod+Shift+m exec --no-startup-id redshift -x && killall redshift

# Polybar / Waybar toggle
bindsym $mod+b exec --no-startup-id polybar-msg cmd toggle

# Reload / Exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+m exec --no-startup-id i3-nagbar -t warning \
    -m 'Exit i3?' \
    -B 'Logout'    'i3-msg exit' \
    -B 'Suspend'   'systemctl suspend' \
    -B 'Hibernate' 'systemctl hibernate' \
    -B 'Reboot'    'systemctl reboot' \
    -B 'Shutdown'  'systemctl poweroff'

#############################
# MEDIA KEYS
#############################

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +2%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -2%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +1%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 1%-

#############################
# RESIZE MODE
#############################

mode "resize" {
    bindsym h resize shrink width  5 px or 5 ppt
    bindsym j resize grow   height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow   width  5 px or 5 ppt

    bindsym Left  resize shrink width  5 px or 5 ppt
    bindsym Down  resize grow   height 5 px or 5 ppt
    bindsym Up    resize shrink height 5 px or 5 ppt
    bindsym Right resize grow   width  5 px or 5 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"
